# ============================================================================
# 训记 API 探针 / 后续同步用的环境变量模板
#
# 用法：
#   1) 复制本文件为 .env
#      bash:        cp .env.example .env
#      PowerShell:  Copy-Item .env.example .env
#   2) 把下面的占位符替换成你在训记 App 里获取到的真实 Key
#   3) 运行探针：node scripts/probe_xunji.mjs
#
# 安全红线：
#   - .env 已被 .gitignore 忽略，严禁提交到版本库
#   - 严禁把真实 Key 写进本模板、任何文档、日志或报告
#   - 脚本输出的日志与报告中，Key 一律以 ****后四位 形式掩码展示
# ============================================================================

# 必填。训记 Open API Key（放在 Authorization 请求头里：Bearer <key>）
XUNJI_API_KEY=PASTE_YOUR_XUNJI_KEY_HERE

# 可选。覆盖 API 基址，默认 https://trains.xunjiapp.cn
# 一般情况下不需要改，改了反而可能连不上
# XUNJI_BASE_URL=https://trains.xunjiapp.cn

# ============================================================================
# AI（排计划 / 复盘总结）—— LLM（V4）
#
# 这一节也可以完全不用手改：跑起服务后在「设置 → AI 排计划」里填，
# 保存时会**自动写回本文件**并立即生效（不用重启）。
#
# 🔴 安全红线：LLM_API_KEY 只放这个文件。它不入库、不写日志、不回传前端；
#    设置页只显示掩码 ****后四位。本文件已被 .gitignore 忽略，严禁提交。
#
# 默认接 DeepSeek（https://api-docs.deepseek.com/zh-cn）：
#   base_url  https://api.deepseek.com
#   model     deepseek-flash（便宜、够用）/ deepseek-v4-pro（更强、更贵）
# 任何 OpenAI 兼容端点都能用（Qwen / Kimi / 本地 vLLM / ollama 等）：
# 只改 base_url 与 model 即可，协议不用动。
# ============================================================================

# 可选。http = 走下面的 OpenAI 兼容端点；off = 显式关闭 AI（即使填了 Key 也不调用，
# 排计划直接用规则模板）。缺省 = http
# LLM_MODE=http

# 可选。OpenAI 兼容端点基址。默认 https://api.deepseek.com
# LLM_BASE_URL=https://api.deepseek.com

# 可选。模型名。默认 deepseek-flash
# LLM_MODEL=deepseek-flash

# 必填（非本地端点）。API Key。缺 Key 时排计划直接用规则模板，不会发起任何网络请求
LLM_API_KEY=PASTE_YOUR_LLM_KEY_HERE

# 可选。单次回复的 token 上限。
#
# 🔴 注意：这是**含推理内容的总额度**，不是「写 JSON 的额度」。deepseek-flash 是推理模型，
#    排一份周计划时会先花掉约 7700 个 token 思考，真正的 JSON 只占 2700 左右。
#    给 8192 会被硬切断（finish_reason=length）→ JSON 解析失败 → 重试全废 → 降级规则模板。
#    实测 32768 一次通过。上限只在真正用到时才计费，所以给大不浪费钱。
# 默认 32768
# LLM_MAX_TOKENS=32768

# 可选。采样温度。结构化输出要稳 → 默认 0.3
# LLM_TEMPERATURE=0.3

# 可选。单次调用超时（毫秒）。默认 120000
# ATP_AI_TIMEOUT_MS=120000

